ENV=development
APP_ORIGIN=http://localhost:8080
# The app and the tests connect as a login role limited to app_runtime's grants. app_web and its
# password are development-only (infra/postgres/dev-roles.sql).
DATABASE_URL=postgres://app_web:app_web@127.0.0.1:5432/app
# The schema owner. Used only by `deno task migrate`; the app never reads it.
MIGRATION_DATABASE_URL=postgres://app:app@127.0.0.1:5432/app
SESSION_SECRET=replace-this-development-only-secret-with-at-least-32-bytes
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
OTEL_DENO=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
