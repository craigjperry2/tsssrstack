{
  "name": "tsssrstack",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "tsc && (tsc --watch --preserveWatchOutput & exec node --watch --permission --allow-child-process --allow-fs-read=dist --allow-fs-read=node_modules --allow-fs-read=src/app/static --allow-fs-read=src/app/adapters/persistence/sql --allow-net dist/src/app/main.js)",
    "start": "tsc && exec node --permission --allow-fs-read=dist --allow-fs-read=node_modules --allow-fs-read=src/app/static --allow-fs-read=src/app/adapters/persistence/sql --allow-net dist/src/app/main.js",
    "migrate": "tsc && exec node --permission --allow-fs-read=dist --allow-fs-read=node_modules --allow-fs-read=migrations --allow-net dist/src/app/adapters/persistence/migrate.js",
    "test": "tsc && node --test --test-isolation=none --permission --allow-fs-read=. --allow-addons --allow-net 'dist/tests/**/*_test.js'"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "bulma": "1.0.4",
    "hono": "4.13.12",
    "postgres": "3.4.9",
    "sqids": "0.3.0"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.86.0",
    "@types/node": "26.6.4",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26",
    "pnpm": ">=12"
  }
}
